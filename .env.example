# ─── Application Settings ─────────────────────────────────────────────────────
APP_NAME="Counsellor Wala"
APP_VERSION="2.0.0"
DEBUG=true
SECRET_KEY=your-secret-key-here
OTP_SECRET_SALT=your-otp-salt-here

# ─── MongoDB (Primary Database) ───────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=councler_v2

# ─── Redis (Optional — for caching) ──────────────────────────────────────────
# Set REDIS_ENABLED=false to run without Redis (uses no-op cache fallback)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ─── AI / LLM (Groq — OpenAI-compatible) ─────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
AI_PROVIDER=groq
GENERATION_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_TOP_K=6

# ─── Vector Search (Pinecone) ─────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=colleges

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ─── Cache TTL (seconds) ─────────────────────────────────────────────────────
CACHE_TTL_RANK_PREDICTION=3600
CACHE_TTL_COLLEGE_RECOMMENDATIONS=1800
CACHE_TTL_COLLEGE_PROFILE=7200
CACHE_TTL_COMPARISON=1800
